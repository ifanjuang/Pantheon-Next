# Langfuse / Hermes environment example
# Status: template candidate. Do not use as a real .env file.
# Copy outside Git and replace every CHANGEME value with generated secrets.

# Public access
LANGFUSE_PUBLIC_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGEME_GENERATE_32_BYTES
SALT=CHANGEME_GENERATE_32_BYTES
ENCRYPTION_KEY=CHANGEME_GENERATE_64_HEX_CHARS

# Bootstrap only. Remove or rotate after first setup if not needed.
LANGFUSE_INIT_ORG_ID=pantheon-next-local
LANGFUSE_INIT_ORG_NAME=Pantheon Next Local
LANGFUSE_INIT_PROJECT_ID=hermes-observability-local
LANGFUSE_INIT_PROJECT_NAME=Hermes Observability Local
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_INIT_USER_EMAIL=admin@example.invalid
LANGFUSE_INIT_USER_NAME=Pantheon Admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME_STRONG_PASSWORD

# Postgres
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=CHANGEME_POSTGRES_PASSWORD
POSTGRES_DB=langfuse
DATABASE_URL=postgresql://langfuse:CHANGEME_POSTGRES_PASSWORD@postgres:5432/langfuse

# ClickHouse
CLICKHOUSE_DB=default
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGEME_CLICKHOUSE_PASSWORD
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
CLICKHOUSE_CLUSTER_ENABLED=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_AUTH=CHANGEME_REDIS_PASSWORD
REDIS_TLS_ENABLED=false

# Object storage, S3-compatible local MinIO example
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGEME_MINIO_PASSWORD
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CHANGEME_MINIO_PASSWORD
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true

LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=CHANGEME_MINIO_PASSWORD
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true

LANGFUSE_S3_BATCH_EXPORT_BUCKET=langfuse
LANGFUSE_S3_BATCH_EXPORT_REGION=auto
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID=minio
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=CHANGEME_MINIO_PASSWORD
LANGFUSE_S3_BATCH_EXPORT_ENDPOINT=http://minio:9000
LANGFUSE_S3_BATCH_EXPORT_FORCE_PATH_STYLE=true

# Optional email, intentionally blank for local test
EMAIL_FROM_ADDRESS=
SMTP_CONNECTION_URL=

# Pantheon/Hermes governance metadata, consumed by future adapter, not by Langfuse itself
PANTHEON_TRACE_REDACTION_PROFILE=synthetic_only
PANTHEON_TRACE_RETENTION_DAYS=7
PANTHEON_TRACE_SCOPE=local_test
PANTHEON_TRACE_CLIENT_DATA_ALLOWED=false
