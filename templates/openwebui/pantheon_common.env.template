# Candidate external OpenWebUI configuration template.
#
# Copy values into the external OpenWebUI deployment only after review.
# This file contains placeholders only and stores no secret.
#
# OpenWebUI exposes. Hermes executes. Pantheon governs.

# OpenWebUI -> authenticated Hermes OpenAI-compatible API.
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URL=http://hermes:8642/v1
OPENAI_API_KEY=<SAME_VALUE_AS_HERMES_API_SERVER_KEY>

# Keep arbitrary upstream passthrough disabled in the common baseline.
ENABLE_OPENAI_API_PASSTHROUGH=false

# Stable OpenWebUI application secret, stored outside the repository.
WEBUI_SECRET_KEY=<OPENWEBUI_SECRET_KEY>

# OpenWebUI application database only.
# The pantheon_knowledge database uses separate roles and responsibilities.
DATABASE_URL=postgresql://openwebui_app:<OPENWEBUI_DB_PASSWORD>@postgres:5432/openwebui_app

# Common services may be installed, but these OpenWebUI-native execution paths
# remain default-off until a reviewed binding is adopted:
#
# ENABLE_WEB_SEARCH=false
# WEB_SEARCH_ENGINE=searxng
# SEARXNG_QUERY_URL=http://searxng:8080/search?q=<query>
# VECTOR_DB=pgvector
# PGVECTOR_DB_URL=postgresql://<ROLE>:<PASSWORD>@postgres:5432/<DATABASE>
# CONTENT_EXTRACTION_ENGINE=docling
#
# Do not uncomment these lines merely because SearXNG, pgvector or Docling is
# reachable. Installed != binding selected != task-authorized.
