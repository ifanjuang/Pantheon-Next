#!/usr/bin/env bash
set -Eeuo pipefail

TOOL_VERSION="0.1.0"
CONFIG_ROOT="/etc/pantheon-node"
APP_ROOT="/opt/pantheon-node"
STATE_ROOT="/srv/pantheon"
PANTHEON_ROOT="/opt/pantheon"
UV_PYTHON_INSTALL_DIR="$APP_ROOT/python"
export UV_PYTHON_INSTALL_DIR
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
RELEASE_LOCK="$SCRIPT_DIR/release.env"
if [[ ! -f "$RELEASE_LOCK" ]]; then
  printf '[pantheon-update] ERROR: reviewed deployment lock is missing: %s\n' "$RELEASE_LOCK" >&2
  exit 1
fi
# shellcheck disable=SC1091
source "$RELEASE_LOCK"

# Reviewed deployment-candidate targets. These are not qualification or authorization truth.
TARGET_HERMES_IMAGE="${RELEASE_HERMES_IMAGE:?release.env missing RELEASE_HERMES_IMAGE}"
TARGET_HINDSIGHT_IMAGE="${RELEASE_HINDSIGHT_IMAGE:?release.env missing RELEASE_HINDSIGHT_IMAGE}"
TARGET_COUCHDB_IMAGE="${RELEASE_COUCHDB_IMAGE:?release.env missing RELEASE_COUCHDB_IMAGE}"
TARGET_OLLAMA_VERSION="${RELEASE_OLLAMA_VERSION:?release.env missing RELEASE_OLLAMA_VERSION}"
TARGET_COMFYUI_REF="${RELEASE_COMFYUI_REF:?release.env missing RELEASE_COMFYUI_REF}"
TARGET_COMFYUI_PYTHON="${RELEASE_COMFYUI_PYTHON:?release.env missing RELEASE_COMFYUI_PYTHON}"
TARGET_TORCH_VERSION="${RELEASE_TORCH_VERSION:?release.env missing RELEASE_TORCH_VERSION}"
TARGET_TORCHVISION_VERSION="${RELEASE_TORCHVISION_VERSION:?release.env missing RELEASE_TORCHVISION_VERSION}"
TARGET_TORCHAUDIO_VERSION="${RELEASE_TORCHAUDIO_VERSION:?release.env missing RELEASE_TORCHAUDIO_VERSION}"
TARGET_TORCH_INDEX="${RELEASE_TORCH_INDEX:?release.env missing RELEASE_TORCH_INDEX}"
TARGET_LIVESYNC_REF="${RELEASE_LIVESYNC_REF:?release.env missing RELEASE_LIVESYNC_REF}"
TARGET_LIVESYNC_IMAGE="${RELEASE_LIVESYNC_IMAGE:?release.env missing RELEASE_LIVESYNC_IMAGE}"
TARGET_LIVESYNC_BUILD_NPM_VERSION="${RELEASE_LIVESYNC_BUILD_NPM_VERSION:?release.env missing RELEASE_LIVESYNC_BUILD_NPM_VERSION}"
LIVESYNC_REPOSITORY="https://github.com/vrtmrz/obsidian-livesync.git"

APPLY=0
ASSUME_YES=0
COMPONENT="all"

log() { printf '[pantheon-update] %s\n' "$*"; }
warn() { printf '[pantheon-update] WARNING: %s\n' "$*" >&2; }
die() { printf '[pantheon-update] ERROR: %s\n' "$*" >&2; exit 1; }
git_in_service_repo() {
  local repo="$1"
  shift
  git -c "safe.directory=$repo" -C "$repo" "$@"
}

usage() {
  cat <<'USAGE'
Usage:
  ./update-node --check
  sudo ./update-node --apply [--component all|pantheon|containers|ollama|comfyui|livesync] [--yes]

Pantheon changes require PANTHEON_COMMIT_OVERRIDE=<reviewed full sha>.
Update-node never follows floating :latest tags and never changes activation/authorization state.
USAGE
}

while (($#)); do
  case "$1" in
    --check) APPLY=0; ASSUME_YES=1 ;;
    --apply) APPLY=1 ;;
    --yes) ASSUME_YES=1 ;;
    --component) shift; COMPONENT="${1:?missing component}" ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
  shift
done

case "$COMPONENT" in
  all|pantheon|containers|ollama|comfyui|livesync) ;;
  *) die "unsupported component: $COMPONENT" ;;
esac

[[ -f "$CONFIG_ROOT/versions.env" ]] || die "no existing node installation found at $CONFIG_ROOT"
# shellcheck disable=SC1090
source "$CONFIG_ROOT/versions.env"
# shellcheck disable=SC1090
source "$CONFIG_ROOT/node.env"

compose() {
  local -a files=(-f "$APP_ROOT/compose.yaml")
  if [[ -f "$APP_ROOT/compose.hermes-local.yaml" ]]; then
    files+=(-f "$APP_ROOT/compose.hermes-local.yaml")
  fi
  docker compose --env-file "$APP_ROOT/compose-env" "${files[@]}" "$@"
}

selected() { [[ "$COMPONENT" == "all" || "$COMPONENT" == "$1" ]]; }
set_version() {
  local key="$1" value="$2"
  if grep -q "^${key}=" "$CONFIG_ROOT/versions.env"; then
    sed -i "s|^${key}=.*|${key}=${value}|" "$CONFIG_ROOT/versions.env"
  else
    printf '%s=%s\n' "$key" "$value" >> "$CONFIG_ROOT/versions.env"
  fi
}

set_compose_env() {
  local key="$1" value="$2"
  if grep -q "^${key}=" "$APP_ROOT/compose-env"; then
    sed -i "s|^${key}=.*|${key}=${value}|" "$APP_ROOT/compose-env"
  else
    printf '%s=%s\n' "$key" "$value" >> "$APP_ROOT/compose-env"
  fi
}

current_comfy="$(git_in_service_repo "$APP_ROOT/ComfyUI" describe --tags --exact-match 2>/dev/null || git_in_service_repo "$APP_ROOT/ComfyUI" rev-parse --short HEAD 2>/dev/null || echo absent)"
current_ollama="$(ollama --version 2>/dev/null | awk '{print $NF}' || echo absent)"
current_livesync="$(git -C "$APP_ROOT/obsidian-livesync" rev-parse HEAD 2>/dev/null || echo absent)"

cat <<EOF_STATUS
Node update check — tool $TOOL_VERSION

component        installed / pinned                         target in this updater
Pantheon         ${PANTHEON_COMMIT:-unknown}                explicit reviewed SHA only
Hermes           ${HERMES_IMAGE:-unknown}                   $TARGET_HERMES_IMAGE
Hindsight        ${HINDSIGHT_IMAGE:-unknown}                $TARGET_HINDSIGHT_IMAGE
CouchDB          ${COUCHDB_IMAGE:-unknown}                  $TARGET_COUCHDB_IMAGE
Ollama           $current_ollama                            $TARGET_OLLAMA_VERSION
ComfyUI          $current_comfy                             $TARGET_COMFYUI_REF
Python           ${COMFYUI_PYTHON:-unknown}                 $TARGET_COMFYUI_PYTHON
PyTorch stack    ${TORCH_VERSION:-unknown}                  $TARGET_TORCH_VERSION / $TARGET_TORCH_INDEX
LiveSync source  $current_livesync                          $TARGET_LIVESYNC_REF

available upstream != qualified for this node
successful update != activation or task authorization
EOF_STATUS

((APPLY == 1)) || exit 0
[[ ${EUID:-$(id -u)} -eq 0 ]] || die "--apply must run as root (sudo)"

if ((ASSUME_YES == 0)); then
  [[ -t 0 ]] || die "non-interactive update requires --yes"
  printf 'Create checkpoint and apply component=%s? [y/N] ' "$COMPONENT"
  read -r answer
  [[ "$answer" =~ ^[Yy]$ ]] || exit 0
fi

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
checkpoint="$STATE_ROOT/backups/update-$stamp"
umask 077
install -d -m 0700 "$checkpoint"
cp -a "$CONFIG_ROOT" "$checkpoint/etc-pantheon-node"
cp -a "$APP_ROOT/compose.yaml" "$APP_ROOT/compose-env" "$checkpoint/"
if [[ -f "$APP_ROOT/compose.hermes-local.yaml" ]]; then
  cp -a "$APP_ROOT/compose.hermes-local.yaml" "$checkpoint/"
fi
compose config > "$checkpoint/compose-rendered.yaml"
readlink -f "$PANTHEON_ROOT/current" > "$checkpoint/pantheon-current.txt" 2>/dev/null || true
if [[ -f "$STATE_ROOT/hermes/profiles/pantheon-governed/config.yaml" ]]; then
  install -d -m 0700 "$checkpoint/hermes-pantheon-governed"
  cp -a "$STATE_ROOT/hermes/profiles/pantheon-governed/config.yaml" \
    "$checkpoint/hermes-pantheon-governed/config.yaml"
fi
if [[ -d "$STATE_ROOT/hermes-governed-skills" ]]; then
  cp -a "$STATE_ROOT/hermes-governed-skills" "$checkpoint/hermes-governed-skills"
fi

update_containers() {
  if [[ "${COUCHDB_IMAGE:-}" != "$TARGET_COUCHDB_IMAGE" && "${STATEFUL_BACKUP_CONFIRMED:-0}" != "1" ]]; then
    die "CouchDB target changes stateful runtime; set STATEFUL_BACKUP_CONFIRMED=1 only after a verified backup/rollback point exists"
  fi
  local hindsight_was_running=0
  if docker inspect -f '{{.State.Running}}' pantheon-hindsight 2>/dev/null | grep -qx true; then hindsight_was_running=1; fi
  if ((hindsight_was_running == 1)) && [[ "${HINDSIGHT_IMAGE:-}" != "$TARGET_HINDSIGHT_IMAGE" && "${STATEFUL_BACKUP_CONFIRMED:-0}" != "1" ]]; then
    die "running Hindsight target changes stateful runtime; verify backup/rollback and set STATEFUL_BACKUP_CONFIRMED=1"
  fi
  set_compose_env HERMES_IMAGE "$TARGET_HERMES_IMAGE"
  set_compose_env HINDSIGHT_IMAGE "$TARGET_HINDSIGHT_IMAGE"
  set_compose_env COUCHDB_IMAGE "$TARGET_COUCHDB_IMAGE"
  compose pull couchdb hermes
  if [[ "${ENABLE_HINDSIGHT:-0}" == "1" ]]; then compose --profile hindsight pull hindsight; fi
  compose up -d couchdb
  if [[ -f "$STATE_ROOT/hermes/config.yaml" || -f "$STATE_ROOT/hermes/.env" ]]; then compose up -d hermes; fi
  if ((hindsight_was_running == 1)); then compose --profile hindsight up -d hindsight; fi
  set_version HERMES_IMAGE "$TARGET_HERMES_IMAGE"
  set_version HINDSIGHT_IMAGE "$TARGET_HINDSIGHT_IMAGE"
  set_version COUCHDB_IMAGE "$TARGET_COUCHDB_IMAGE"
}

update_ollama() {
  curl -fsSL https://ollama.com/install.sh | OLLAMA_VERSION="$TARGET_OLLAMA_VERSION" sh
  systemctl restart ollama
  set_version OLLAMA_VERSION "$TARGET_OLLAMA_VERSION"
}

update_comfyui() {
  local managed_python
  [[ -d "$APP_ROOT/ComfyUI/.git" ]] || die "ComfyUI checkout missing"
  "$APP_ROOT/uv/bin/uv" python install "$TARGET_COMFYUI_PYTHON"
  chmod -R a+rX "$UV_PYTHON_INSTALL_DIR"
  managed_python="$("$APP_ROOT/uv/bin/uv" python find --managed-python "$TARGET_COMFYUI_PYTHON")"
  [[ "$managed_python" == "$UV_PYTHON_INSTALL_DIR/"* ]] \
    || die "uv resolved ComfyUI Python outside $UV_PYTHON_INSTALL_DIR: $managed_python"
  git_in_service_repo "$APP_ROOT/ComfyUI" fetch --tags --force
  git_in_service_repo "$APP_ROOT/ComfyUI" checkout --detach "$TARGET_COMFYUI_REF"
  systemctl stop comfyui
  rm -rf "$APP_ROOT/ComfyUI/.venv"
  "$APP_ROOT/uv/bin/uv" venv --python "$managed_python" "$APP_ROOT/ComfyUI/.venv"
  "$APP_ROOT/uv/bin/uv" pip install --python "$APP_ROOT/ComfyUI/.venv/bin/python" \
    "torch==$TARGET_TORCH_VERSION" "torchvision==$TARGET_TORCHVISION_VERSION" \
    "torchaudio==$TARGET_TORCHAUDIO_VERSION" --index-url "$TARGET_TORCH_INDEX"
  "$APP_ROOT/uv/bin/uv" pip install --python "$APP_ROOT/ComfyUI/.venv/bin/python" -r "$APP_ROOT/ComfyUI/requirements.txt"
  chown -R comfyui:comfyui "$APP_ROOT/ComfyUI"
  runuser -u comfyui -- test -x "$APP_ROOT/ComfyUI/.venv/bin/python" \
    || die "ComfyUI's managed Python is not executable by the comfyui service user"
  systemctl restart comfyui
  set_version COMFYUI_PYTHON "$TARGET_COMFYUI_PYTHON"
  set_version COMFYUI_REF "$TARGET_COMFYUI_REF"
  set_version TORCH_VERSION "$TARGET_TORCH_VERSION"
  set_version TORCHVISION_VERSION "$TARGET_TORCHVISION_VERSION"
  set_version TORCHAUDIO_VERSION "$TARGET_TORCHAUDIO_VERSION"
  set_version TORCH_INDEX "$TARGET_TORCH_INDEX"
}

update_livesync() {
  local fresh_install=0 patched_dockerfile npm_injections
  install -d -m 0750 "$STATE_ROOT/livesync/db" "$STATE_ROOT/obsidian"
  if [[ ! -d "$APP_ROOT/obsidian-livesync/.git" ]]; then
    git clone "$LIVESYNC_REPOSITORY" "$APP_ROOT/obsidian-livesync"
    fresh_install=1
  fi
  git_in_service_repo "$APP_ROOT/obsidian-livesync" fetch origin "$TARGET_LIVESYNC_REF"
  git_in_service_repo "$APP_ROOT/obsidian-livesync" checkout --detach "$TARGET_LIVESYNC_REF"
  patched_dockerfile="$(mktemp)"
  sed "/^[[:space:]]*RUN npm install/i RUN npm install --global npm@$TARGET_LIVESYNC_BUILD_NPM_VERSION --no-audit --no-fund" \
    "$APP_ROOT/obsidian-livesync/src/apps/cli/Dockerfile" > "$patched_dockerfile"
  npm_injections="$(grep -Fc "npm@$TARGET_LIVESYNC_BUILD_NPM_VERSION" "$patched_dockerfile")"
  if [[ "$npm_injections" != 2 ]]; then
    rm -f "$patched_dockerfile"
    die "expected two pinned npm injections in the derived LiveSync Dockerfile; found $npm_injections"
  fi
  if ! docker build -f "$patched_dockerfile" -t "$TARGET_LIVESYNC_IMAGE" "$APP_ROOT/obsidian-livesync"; then
    rm -f "$patched_dockerfile"
    die "LiveSync image build failed"
  fi
  rm -f "$patched_dockerfile"

  cat > /usr/local/bin/livesync-cli-node <<EOF_WRAPPER
#!/bin/sh
exec docker run --rm --network host \\
  -e LIVESYNC_DB_PATH=/data/db \\
  -v $STATE_ROOT/livesync/db:/data/db \\
  -v $STATE_ROOT/obsidian:/data/vault \\
  $TARGET_LIVESYNC_IMAGE --vault /data/vault "\$@"
EOF_WRAPPER
  chmod 755 /usr/local/bin/livesync-cli-node

  cat > /etc/systemd/system/livesync-headless.service <<EOF_LIVESYNC
[Unit]
Description=Self-hosted LiveSync headless daemon
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
ConditionPathExists=$STATE_ROOT/livesync/db/.livesync/settings.json

[Service]
Type=simple
ExecStart=/usr/bin/docker run --rm --name pantheon-livesync-headless --network host -e LIVESYNC_DB_PATH=/data/db -v $STATE_ROOT/livesync/db:/data/db -v $STATE_ROOT/obsidian:/data/vault $TARGET_LIVESYNC_IMAGE --settings /data/db/.livesync/settings.json --vault /data/vault daemon --interval 30
ExecStop=-/usr/bin/docker stop -t 20 pantheon-livesync-headless
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF_LIVESYNC
  systemctl daemon-reload
  LIVESYNC_IMAGE="$TARGET_LIVESYNC_IMAGE"
  if ((fresh_install == 1)); then
    systemctl disable livesync-headless.service >/dev/null 2>&1 || true
  else
    systemctl try-restart livesync-headless.service || true
  fi
  set_version LIVESYNC_REF "$TARGET_LIVESYNC_REF"
  set_version LIVESYNC_IMAGE "$TARGET_LIVESYNC_IMAGE"
  set_version LIVESYNC_BUILD_NPM_VERSION "$TARGET_LIVESYNC_BUILD_NPM_VERSION"
}

update_pantheon() {
  if [[ -z ${PANTHEON_COMMIT_OVERRIDE:-} ]]; then
    warn "Pantheon not changed: set PANTHEON_COMMIT_OVERRIDE=<reviewed full sha> to update it"
    return 0
  fi
  [[ "$PANTHEON_COMMIT_OVERRIDE" =~ ^[0-9a-f]{40}$ ]] || die "PANTHEON_COMMIT_OVERRIDE must be a full 40-character SHA"
  local short target repository
  short="${PANTHEON_COMMIT_OVERRIDE:0:12}"
  target="$PANTHEON_ROOT/Pantheon-Next-$short"
  repository="${PANTHEON_REPOSITORY_OVERRIDE:-$(git -C "$PANTHEON_ROOT/current" remote get-url origin 2>/dev/null || true)}"
  [[ -n "$repository" ]] || die "cannot resolve Pantheon repository remote; set PANTHEON_REPOSITORY_OVERRIDE"
  if [[ ! -d "$target/.git" ]]; then git clone "$repository" "$target"; fi
  git -C "$target" fetch origin "$PANTHEON_COMMIT_OVERRIDE"
  git -C "$target" checkout --detach "$PANTHEON_COMMIT_OVERRIDE"
  "$APP_ROOT/uv/bin/uv" pip install --python "$STATE_ROOT/policy-venv/bin/python" --force-reinstall "$target/mcp-server"
  "$STATE_ROOT/policy-venv/bin/pantheon-mcp-server" --help >/dev/null
  ln -sfn "$target" "$PANTHEON_ROOT/current"
  bash "$SCRIPT_DIR/sync-hermes-governed-skills" "$target"
  set_version PANTHEON_COMMIT "$PANTHEON_COMMIT_OVERRIDE"
}

selected containers && update_containers
selected ollama && update_ollama
selected comfyui && update_comfyui
selected livesync && update_livesync
selected pantheon && update_pantheon

log "checkpoint retained at $checkpoint"
log "run service-specific health checks before changing any activation/authorization posture"
