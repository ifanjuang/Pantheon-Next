#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/../.." && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/release.env"
MCP_VERSION="${RELEASE_IFJA_VAULT_MCP_VERSION:?release.env missing RELEASE_IFJA_VAULT_MCP_VERSION}"
SOURCE_ROOT="$REPO_ROOT/implementation/hermes/skills/ifja-vault-search/scripts"
APP_ROOT="/opt/pantheon-node/ifja-vault-read"
UV="/opt/pantheon-node/uv/bin/uv"
TOKEN_FILE="/srv/pantheon/docling/ifja-vault-read.token"
UNIT_FILE="/etc/systemd/system/pantheon-ifja-vault-read.service"
AFFAIRES_ROOT="${AFFAIRES_ROOT:-}"
APPLY=0
ENABLE=0

log() { printf '[ifja-vault-read] %s\n' "$*"; }
die() { printf '[ifja-vault-read] ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
Usage:
  deployment/ubuntu/configure-ifja-vault-read-local --check
  sudo deployment/ubuntu/configure-ifja-vault-read-local --apply --affaires-root PATH [--enable]

Stages a pinned, read-only, authenticated IFJA vault MCP service on loopback.
PATH is the Linux-mounted NAS AFFAIRES root (or set AFFAIRES_ROOT).
--enable is explicit. No Hermes profile or project document is changed here.
USAGE
}

while (($#)); do
  case "$1" in
    --check) APPLY=0 ;;
    --apply) APPLY=1 ;;
    --affaires-root) AFFAIRES_ROOT="${2:?missing AFFAIRES root}"; shift ;;
    --enable) ENABLE=1 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
  shift
done

[[ -f "$SOURCE_ROOT/ifja_vault_mcp.py" && -f "$SOURCE_ROOT/ifja_vault_sources.py" ]] \
  || die "repository-owned vault reader sources are missing"

if ((APPLY == 0)); then
  [[ "$ENABLE" == 0 ]] || die "--enable requires --apply"
  [[ -x "$APP_ROOT/.venv/bin/python" ]] && log "isolated runtime present" \
    || log "isolated runtime absent"
  [[ -f "$TOKEN_FILE" ]] && log "bearer token present (not displayed)" \
    || log "bearer token absent"
  [[ -n "$AFFAIRES_ROOT" ]] && log "AFFAIRES root selected" \
    || log "AFFAIRES root not selected"
  if systemctl is-active --quiet pantheon-ifja-vault-read.service; then
    log "loopback service active"
  else
    log "loopback service inactive"
  fi
  log "check only; no state changed"
  exit 0
fi

[[ ${EUID:-$(id -u)} -eq 0 ]] || die "--apply requires root"
id -u pantheon-docling >/dev/null 2>&1 \
  || die "pantheon-docling service user is required; install Docling first"
[[ -x "$UV" ]] || die "managed uv is missing: $UV"
[[ -n "$AFFAIRES_ROOT" && "$AFFAIRES_ROOT" = /* ]] \
  || die "set --affaires-root to an absolute Linux-mounted NAS path"
[[ -d "$AFFAIRES_ROOT" ]] || die "AFFAIRES mount is missing"
runuser -u pantheon-docling -- test -r "$AFFAIRES_ROOT" \
  || die "pantheon-docling cannot read AFFAIRES mount"
runuser -u pantheon-docling -- test -x "$AFFAIRES_ROOT" \
  || die "pantheon-docling cannot traverse AFFAIRES mount"
[[ -d /srv/pantheon/obsidian-documentaires ]] \
  || die "DOCUMENTAIRES mirror is missing"

install -d -m 0755 "$APP_ROOT"
if [[ -f "$APP_ROOT/ifja_vault_mcp.py" || -f "$UNIT_FILE" ]]; then
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  backup="/srv/pantheon/backups/ifja-vault-read-$stamp"
  install -d -m 0700 "$backup"
  [[ ! -f "$APP_ROOT/ifja_vault_mcp.py" ]] || cp -a "$APP_ROOT/ifja_vault_mcp.py" "$backup/"
  [[ ! -f "$APP_ROOT/ifja_vault_sources.py" ]] || cp -a "$APP_ROOT/ifja_vault_sources.py" "$backup/"
  [[ ! -f "$UNIT_FILE" ]] || cp -a "$UNIT_FILE" "$backup/"
  log "previous service code/config checkpoint: $backup"
fi
install -m 0644 "$SOURCE_ROOT/ifja_vault_mcp.py" "$APP_ROOT/ifja_vault_mcp.py"
install -m 0644 "$SOURCE_ROOT/ifja_vault_sources.py" "$APP_ROOT/ifja_vault_sources.py"
if [[ ! -x "$APP_ROOT/.venv/bin/python" ]]; then
  "$UV" venv --python /usr/bin/python3 "$APP_ROOT/.venv"
fi
"$UV" pip install --python "$APP_ROOT/.venv/bin/python" "mcp==$MCP_VERSION"
chmod -R a+rX "$APP_ROOT"

install -d -o pantheon-docling -g pantheon-docling -m 0750 /srv/pantheon/docling
if [[ ! -e "$TOKEN_FILE" ]]; then
  umask 077
  openssl rand -hex 32 > "$TOKEN_FILE"
fi
chown pantheon-docling:pantheon-docling "$TOKEN_FILE"
chmod 0600 "$TOKEN_FILE"

cat > "$UNIT_FILE" <<EOF_UNIT
[Unit]
Description=Read-only IFJA vault MCP reader for Hermes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pantheon-docling
Group=pantheon-docling
WorkingDirectory=$APP_ROOT
Environment=IFJA_AFFAIRES_ROOT=$AFFAIRES_ROOT
Environment=IFJA_DOCUMENTAIRES_ROOT=/srv/pantheon/obsidian-documentaires
Environment=IFJA_VAULT_TOKEN_FILE=$TOKEN_FILE
ExecStart=$APP_ROOT/.venv/bin/python $APP_ROOT/ifja_vault_mcp.py --http
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=$AFFAIRES_ROOT /srv/pantheon/obsidian-documentaires $TOKEN_FILE

[Install]
WantedBy=multi-user.target
EOF_UNIT
chmod 0644 "$UNIT_FILE"
systemctl daemon-reload
if ((ENABLE == 1)); then
  systemctl enable pantheon-ifja-vault-read.service
  if systemctl is-active --quiet pantheon-ifja-vault-read.service; then
    systemctl restart pantheon-ifja-vault-read.service
  else
    systemctl start pantheon-ifja-vault-read.service
  fi
  log "enabled authenticated MCP on 127.0.0.1:8021"
else
  log "staged but not activated; rerun with --apply --enable after review"
fi
log "Hermes binding remains a separate explicit --with-ifja-adapter --bind-local-mcp step"
