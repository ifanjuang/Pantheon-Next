{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pantheon://schemas/architecture-proof-register/proof_entry.schema.json",
  "title": "Proof Entry",
  "description": "Relation saying that evidence supports a claim, status or professional object. It records support; it does not decide truth alone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["proof_entry_id", "scope_id", "professional_object_type", "claim_or_status", "proof_status", "approval_state"],
  "properties": {
    "proof_entry_id": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/uuid" },
    "human_ref": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/human_ref" },
    "scope_id": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/uuid" },
    "scope_type": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/scope_type" },
    "scope_notes": { "type": "string" },
    "professional_object_type": { "type": "string", "minLength": 1 },
    "professional_object_ref": { "type": "string" },
    "professional_object_label": { "type": "string" },
    "claim_or_status": { "type": "string", "minLength": 1 },
    "evidence_refs": {
      "type": "array",
      "items": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/evidence_ref" },
      "default": []
    },
    "source_document_family_id": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/uuid" },
    "source_document_family_label": { "type": "string" },
    "source_document_version_id": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/uuid" },
    "source_index_label": { "type": "string" },
    "source_authority_level": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/source_authority_level" },
    "phase_code": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/phase_code" },
    "lot_id": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/uuid" },
    "lot_label": { "type": "string" },
    "proof_status": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/proof_status" },
    "proof_notes": { "type": "string" },
    "approval_state": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/approval_state" },
    "approval_notes": { "type": "string" },
    "allowed_use": { "type": "array", "items": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/use_type" }, "uniqueItems": true },
    "allowed_use_notes": { "type": "string" },
    "forbidden_use": { "type": "array", "items": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/use_type" }, "uniqueItems": true },
    "forbidden_use_notes": { "type": "string" },
    "requested_use": { "type": "array", "items": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/use_type" }, "uniqueItems": true },
    "requested_use_notes": { "type": "string" },
    "produced_by": { "type": "string" },
    "reviewed_by": { "type": "string" },
    "supersedes_proof_entry_id": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/uuid" },
    "superseded_by_proof_entry_id": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/uuid" },
    "created_at": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/date" },
    "metadata": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/metadata" }
  }
}
