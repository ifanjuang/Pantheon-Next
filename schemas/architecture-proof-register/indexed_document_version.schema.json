{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pantheon://schemas/architecture-proof-register/indexed_document_version.schema.json",
  "title": "Indexed Document Version",
  "description": "One preserved index of a document family. Effect class and phase may be absent at capture but should trigger review when authority is claimed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_version_id", "document_family_id", "scope_id", "index_label", "version_status", "authority_status"],
  "properties": {
    "document_version_id": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/uuid" },
    "human_ref": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/human_ref" },
    "document_family_id": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/uuid" },
    "document_family_label": { "type": "string" },
    "scope_id": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/uuid" },
    "scope_type": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/scope_type" },
    "scope_notes": { "type": "string" },
    "index_label": { "type": "string", "minLength": 1 },
    "version_label": { "type": "string" },
    "phase_code": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/phase_code" },
    "effect_class": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/effect_class" },
    "revision_reason": { "type": "string" },
    "source_authority_level": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/source_authority_level" },
    "version_status": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/version_status" },
    "authority_status": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/authority_status" },
    "authority_notes": { "type": "string" },
    "supersedes_version_id": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/uuid" },
    "issued_by": { "type": "string" },
    "issued_at": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/date" },
    "approved_by": { "type": "string" },
    "approved_at": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/date" },
    "signed_by": { "type": "string" },
    "signed_at": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/date" },
    "effective_at": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/date" },
    "valid_from": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/date" },
    "valid_until": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/date" },
    "duration_calendar_days": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/positive_integer" },
    "duration_working_days": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/positive_integer" },
    "hash_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "source_file_ref": { "type": "string" },
    "allowed_use": { "type": "array", "items": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/use_type" }, "uniqueItems": true },
    "allowed_use_notes": { "type": "string" },
    "forbidden_use": { "type": "array", "items": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/use_type" }, "uniqueItems": true },
    "forbidden_use_notes": { "type": "string" },
    "metadata": { "$ref": "pantheon://schemas/architecture-proof-register/shared.schema.json#/$defs/metadata" }
  }
}
