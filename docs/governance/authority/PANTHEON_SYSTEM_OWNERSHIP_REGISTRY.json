{
  "registry_id": "pantheon.system_ownership",
  "revision": 1,
  "status": "candidate_support_registry",
  "authority_note": "This registry records expected ownership for architecture convergence. It does not promote a candidate, authorize execution, admit Evidence, or replace the master authority index.",
  "owners": {
    "Pantheon-Next": {
      "role": "governance",
      "owns": [
        "doctrine",
        "governed concepts",
        "schemas",
        "statuses",
        "Evidence semantics",
        "scope",
        "approvals",
        "Capability Slots"
      ]
    },
    "pantheon-mvp": {
      "role": "implementation",
      "owns": [
        "PostgreSQL persistence",
        "APIs",
        "executable projections",
        "bounded adapters",
        "integration seams"
      ]
    },
    "Hermes/external runtime": {
      "role": "runtime",
      "owns": [
        "execution",
        "tools",
        "provider routing",
        "runtime-local state"
      ]
    },
    "Cockpit/OpenWebUI": {
      "role": "projection",
      "owns": [
        "interaction",
        "display",
        "decision surfaces"
      ]
    }
  },
  "boundary_rules": [
    "installed != approved",
    "healthy != safe",
    "runtime_success != Evidence",
    "retrieved != truth",
    "binding_selected != dependency_adopted",
    "activated != task_authorized",
    "UI status != authorization"
  ],
  "concepts": [
